@page
@model InvestmentPlanner.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Funds";
}

<script>
    window.finLensApiBaseUrl = "@Model.ApiBaseUrl";
</script>

@Html.AntiForgeryToken()

<section class="fl-hero">

    <div class="fl-hero-inner">

        <h1>
            Find and analyze mutual funds
        </h1>

        <p class="fl-hero-sub">
            Live NAV, returns and CAGR sourced directly from MFAPI.
        </p>

        <div class="fl-search-wrap">

            <input
                id="fl-search-input"
                class="fl-search-input"
                type="text"
                placeholder="Search by fund name, AMC, or category&hellip; e.g. HDFC, SBI, Flexi Cap"
                autocomplete="off" />

            <button
                id="fl-search-clear"
                class="fl-search-clear"
                type="button"
                aria-label="Clear search"
                hidden>
                &times;
            </button>

        </div>

        <p
            id="fl-search-status"
            class="fl-search-status"
            aria-live="polite">
        </p>

    </div>

</section>


<!-- =========================================================
     MAIN CONTENT
     ========================================================= -->

<div class="fl-content">


    <!-- =====================================================
         FILTERS
         ===================================================== -->

    <aside
        class="fl-filters"
        id="fl-filters">

        <h2 class="fl-filters-title">
            Filters
        </h2>


        <!-- =================================================
             PLAN
             ================================================= -->

        <div class="fl-filter-group">

            <h3>
                Plan
            </h3>

            <div
                class="fl-checkbox-list"
                id="fl-filter-plan">

                <p class="fl-filter-empty">
                    Loading plans&hellip;
                </p>

            </div>

        </div>


        <!-- =================================================
             OPTION
             ================================================= -->

        <div class="fl-filter-group">

            <h3>
                Option
            </h3>

            <div
                class="fl-checkbox-list"
                id="fl-filter-option">

                <p class="fl-filter-empty">
                    Loading options&hellip;
                </p>

            </div>

        </div>


        <!-- =================================================
             AMC
             ================================================= -->

        <div class="fl-filter-group">

            <h3>
                AMC
            </h3>

            <input
                type="text"
                class="fl-filter-search"
                placeholder="Search AMCs&hellip;"
                data-target="fl-filter-amc"
                autocomplete="off" />

            <div
                class="fl-checkbox-list fl-checkbox-list-scroll"
                id="fl-filter-amc">

                <p class="fl-filter-empty">
                    Loading AMCs&hellip;
                </p>

            </div>

        </div>


        <!-- =================================================
             CATEGORY
             ================================================= -->

        <div class="fl-filter-group">

            <h3>
                Category
            </h3>

            <input
                type="text"
                class="fl-filter-search"
                placeholder="Search categories&hellip;"
                data-target="fl-filter-category"
                autocomplete="off" />

            <div
                class="fl-checkbox-list fl-checkbox-list-scroll"
                id="fl-filter-category">

                <p class="fl-filter-empty">
                    Loading categories&hellip;
                </p>

            </div>

        </div>


        <!-- =================================================
             SUB-CATEGORY
             ================================================= -->

        <div class="fl-filter-group">

            <h3>
                Sub-Category
            </h3>

            <input
                type="text"
                class="fl-filter-search"
                placeholder="Search sub-categories&hellip;"
                data-target="fl-filter-subcategory"
                autocomplete="off" />

            <div
                class="fl-checkbox-list fl-checkbox-list-scroll"
                id="fl-filter-subcategory">

                <p class="fl-filter-empty">
                    Loading sub-categories&hellip;
                </p>

            </div>

        </div>


        <!-- =================================================
             FILTER ACTIONS
             ================================================= -->

        <div class="fl-filter-actions">

            <button
                id="fl-filters-apply"
                class="fl-filters-apply"
                type="button">

                Apply Filters

            </button>

            <button
                id="fl-filters-clear"
                class="fl-filters-clear"
                type="button">

                Clear Filters

            </button>

        </div>

    </aside>


    <!-- =====================================================
         RESULTS AREA
         ===================================================== -->

    <section class="fl-results">


        <!-- =================================================
             TOP PERFORMING FUNDS

             Hidden by default.

             JavaScript should show this only when:
             - search box is empty
             - no filters are applied

             It should hide when:
             - user searches
             - user applies filters
         ================================================= -->

        <section
            id="fl-top-performing"
            class="fl-top-performing"
            hidden>


            <!-- =============================================
                 HEADER
                 ============================================= -->

            <div class="fl-top-performing-header">

                <span class="fl-section-label">
                    FINLENS HIGHLIGHTS
                </span>

                <h2>
                    Top Performing Funds
                </h2>

                <p>
                    One top-performing Direct Growth fund from
                    each available category, based on historical CAGR.
                </p>

            </div>


            <!-- =============================================
                 LOADING
                 ============================================= -->

            <div
                id="fl-top-performing-loading"
                class="fl-top-performing-loading">

                Loading top-performing funds&hellip;

            </div>


            <!-- =============================================
                 ERROR / EMPTY STATE
                 ============================================= -->

            <p
                id="fl-top-performing-empty"
                class="fl-top-performing-empty"
                hidden>

                Unable to load top-performing funds right now.

            </p>


            <!-- =============================================
                 3 YEAR
                 ============================================= -->

            <section class="fl-top-performing-period">

                <div class="fl-top-performing-period-header">

                    <h3>
                        3 Year
                    </h3>

                    <span class="fl-top-performing-period-label">
                        3Y CAGR
                    </span>

                </div>

                <div
                    id="fl-top-three-grid"
                    class="fl-top-performing-grid">
                </div>

            </section>


            <!-- =============================================
                 5 YEAR
                 ============================================= -->

            <section class="fl-top-performing-period">

                <div class="fl-top-performing-period-header">

                    <h3>
                        5 Year
                    </h3>

                    <span class="fl-top-performing-period-label">
                        5Y CAGR
                    </span>

                </div>

                <div
                    id="fl-top-five-grid"
                    class="fl-top-performing-grid">
                </div>

            </section>


            <!-- =============================================
                 10 YEAR
                 ============================================= -->

            <section class="fl-top-performing-period">

                <div class="fl-top-performing-period-header">

                    <h3>
                        10 Year
                    </h3>

                    <span class="fl-top-performing-period-label">
                        10Y CAGR
                    </span>

                </div>

                <div
                    id="fl-top-ten-grid"
                    class="fl-top-performing-grid">
                </div>

            </section>

        </section>


        <!-- =================================================
             SEARCH RESULTS HEADER
             ================================================= -->

        <div class="fl-results-header">

            <h2 id="fl-results-title">
                Search Funds
            </h2>

            <span
                id="fl-results-count"
                class="fl-results-count">
            </span>

        </div>


        <!-- =================================================
             SEARCH RESULTS GRID
             ================================================= -->

        <div
            id="fl-results-grid"
            class="fl-fund-grid">
        </div>


        <!-- =================================================
             EMPTY SEARCH RESULTS
             ================================================= -->

        <div
            id="fl-results-empty"
            class="fl-empty-state"
            hidden>

            <p>
                No funds match your search and filters right now.
            </p>

        </div>


        <!-- =================================================
             SEARCH RESULTS LOADING
             ================================================= -->

        <div
            id="fl-results-loading"
            class="fl-loading-state"
            hidden>

            <p>
                Loading funds&hellip;
            </p>

        </div>

    </section>

</div>


<!-- =========================================================
     FUND CARD TEMPLATE
     ========================================================= -->

<template id="fl-fund-card-template">

    <a
        class="fl-fund-card"
        href="#">


        <!-- =================================================
             FUND CARD HEADER
             ================================================= -->

        <div class="fl-fund-card-header">

            <h3 class="fl-fund-name">
            </h3>

            <span
                class="fl-fund-tag fl-fund-plan">
            </span>

        </div>


        <!-- =================================================
             NAV
             ================================================= -->

        <div class="fl-fund-nav">

            <span class="fl-fund-nav-label">
                NAV
            </span>

            <span class="fl-fund-nav-value">
            </span>

        </div>


        <!-- =================================================
             PERFORMANCE METRICS
             ================================================= -->

        <div class="fl-fund-metrics">


            <!-- 1 MONTH -->

            <div class="fl-metric">

                <span class="fl-metric-label">
                    1M
                </span>

                <span
                    class="fl-metric-value fl-m1">
                </span>

            </div>


            <!-- 3 MONTH -->

            <div class="fl-metric">

                <span class="fl-metric-label">
                    3M
                </span>

                <span
                    class="fl-metric-value fl-m3">
                </span>

            </div>


            <!-- 6 MONTH -->

            <div class="fl-metric">

                <span class="fl-metric-label">
                    6M
                </span>

                <span
                    class="fl-metric-value fl-m6">
                </span>

            </div>


            <!-- 1 YEAR -->

            <div class="fl-metric">

                <span class="fl-metric-label">
                    1Y
                </span>

                <span
                    class="fl-metric-value fl-y1">
                </span>

            </div>


            <!-- 3 YEAR -->

            <div class="fl-metric">

                <span class="fl-metric-label">
                    3Y
                </span>

                <span
                    class="fl-metric-value fl-y3">
                </span>

            </div>


            <!-- 5 YEAR -->

            <div class="fl-metric">

                <span class="fl-metric-label">
                    5Y
                </span>

                <span
                    class="fl-metric-value fl-y5">
                </span>

            </div>


            <!-- 10 YEAR -->

            <div class="fl-metric">

                <span class="fl-metric-label">
                    10Y
                </span>

                <span
                    class="fl-metric-value fl-y10">
                </span>

            </div>

        </div>


        <!-- =================================================
             FUND HOUSE
             ================================================= -->

        <div class="fl-fund-footer">

            <span class="fl-fund-amc">
            </span>

        </div>

    </a>

</template>